{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartCoachDb": "Host=smart-coach-db;Port=5432;Database=smart_coach_service;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "fitness-app.exchange"
  },
  "Services": {
    "ProfileService": { "BaseUrl": "http://userprofileservice" },
    "FceService": { "BaseUrl": "http://fce-service" },
    "WorkoutService": { "BaseUrl": "http://workoutservice" },
    "NutritionService": { "BaseUrl": "http://nutritionservice" },
    "ProgressService": { "BaseUrl": "http://progressservice" },
    "AiCoachProvider": { "BaseUrl": "https://api.anthropic.com" }
  },
  "Jwt": {
    "Issuer": "FitnessApp.AuthenticationService",
    "Audience": "FitnessApp.Clients",
    "Key": "__replace_with_shared_signing_key__"
  }
}
